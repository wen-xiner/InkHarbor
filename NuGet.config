<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    InkHarbor 零第三方依赖，只用 BCL，所以只需要官方源。
    这里显式 <clear /> 掉机器级 NuGet.Config 里的其它源（比如公司内网源），
    保证换台机器、换个人 clone 下来都能直接 restore / publish。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
