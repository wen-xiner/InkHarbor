<Window x:Class="InkHarbor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:InkHarbor.App.ViewModels"
        Title="InkHarbor · 墨坞" Height="860" Width="1260" MinHeight="660" MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        Foreground="{StaticResource TextPrimary}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 顶栏 ================= -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderTertiary}" BorderThickness="0.5"
                CornerRadius="12,12,0,0" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="InkHarbor" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="文风模式" Margin="20,0,8,0" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" FontSize="12" />
                    <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                              Width="190" FontSize="12" />
                    <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Text="{Binding OllamaStatusText}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOllamaConnected}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ================= 主体 ================= -->
        <Border Grid.Row="1" Background="{StaticResource BgPrimary}"
                BorderBrush="{StaticResource BorderTertiary}" BorderThickness="0.5,0,0.5,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左栏双 Tab -->
                <Border Grid.Column="0" Background="{StaticResource BgTertiary}"
                        BorderBrush="{StaticResource BorderTertiary}" BorderThickness="0,0,0.5,0">
                    <TabControl Margin="8,6,8,8">

                        <TabItem Header="作品">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ListBox x:Name="DraftList" ItemsSource="{Binding DraftItems}"
                                         SelectedItem="{Binding SelectedDraft, Mode=TwoWay}"
                                         SelectionChanged="DraftList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgPrimary}"
                                                    BorderBrush="{StaticResource BorderTertiary}" BorderThickness="0.5"
                                                    CornerRadius="8" Padding="9,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="{Binding AccentWidth}"
                                                            Background="{Binding AccentBrush}" CornerRadius="2"
                                                            Margin="0,1,8,1" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"
                                                                   FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StatusLine}" FontSize="11"
                                                                   Foreground="{Binding StatusBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Grid.Row="1" FontSize="11" Foreground="{StaticResource TextTertiary}"
                                           TextWrapping="Wrap" LineHeight="17" Margin="0,10,0,0"
                                           Text="底稿=灰 / 修改中=蓝 / 已入终稿=绿。点一条打开它。" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="范文库">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ListBox x:Name="CorpusList" ItemsSource="{Binding CorpusItems}"
                                         SelectedItem="{Binding SelectedCorpus, Mode=TwoWay}"
                                         MouseDoubleClick="CorpusList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgPrimary}"
                                                    BorderBrush="{StaticResource BorderTertiary}" BorderThickness="0.5"
                                                    CornerRadius="8" Padding="8,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              VerticalAlignment="Top" Margin="0,2,7,0" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding TagText}" FontSize="11"
                                                                   Foreground="{StaticResource TextTertiary}"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding MetaText}" FontSize="11"
                                                                   Foreground="{StaticResource TextTertiary}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                    <WrapPanel>
                                        <Button Content="打开文件夹" Style="{StaticResource MiniButton}"
                                                Command="{Binding OpenCorpusFolderCommand}" />
                                        <Button Content="新建" Style="{StaticResource MiniButton}"
                                                Command="{Binding NewCorpusCommand}" />
                                        <Button Content="编辑" Style="{StaticResource MiniButton}"
                                                Command="{Binding EditCorpusCommand}" />
                                        <Button Content="改名" Style="{StaticResource MiniButton}"
                                                Command="{Binding RenameCorpusCommand}" />
                                        <Button Content="移出" Style="{StaticResource MiniButton}"
                                                Command="{Binding DeleteCorpusCommand}" />
                                    </WrapPanel>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextTertiary}"
                                               TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"
                                               Text="勾选进右侧配方条；双击看整篇预览。选中一条后可编辑、改名、移出（移到 corpus\_trash\，能手动找回）。" />
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="预设">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ListBox x:Name="PresetList" ItemsSource="{Binding Presets}"
                                         SelectedItem="{Binding SelectedPreset, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgPrimary}"
                                                    BorderBrush="{StaticResource BorderTertiary}" BorderThickness="0.5"
                                                    CornerRadius="8" Padding="8,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding MetaLine}" FontSize="11"
                                                               Foreground="{StaticResource TextTertiary}"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding PreviewText}" FontSize="11"
                                                               Foreground="{StaticResource TextTertiary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                    <WrapPanel>
                                        <Button Content="应用" Style="{StaticResource MiniButton}"
                                                Command="{Binding ApplyPresetCommand}" />
                                        <Button Content="改名" Style="{StaticResource MiniButton}"
                                                Command="{Binding RenamePresetCommand}" />
                                        <Button Content="覆盖" Style="{StaticResource MiniButton}"
                                                Command="{Binding OverwritePresetCommand}" />
                                        <Button Content="删除" Style="{StaticResource MiniButton}"
                                                Command="{Binding DeletePresetCommand}" />
                                    </WrapPanel>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextTertiary}"
                                               TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"
                                               Text="「应用」把这条配方填回右侧配方条；「覆盖」＝用现在勾的几篇替换掉它。" />
                                </StackPanel>
                            </Grid>
                        </TabItem>

                    </TabControl>
                </Border>

                <!-- 右栏 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="110" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition>
                            <RowDefinition.Style>
                                <Style TargetType="RowDefinition">
                                    <Setter Property="Height" Value="340" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditPanelOpen}" Value="False">
                                            <Setter Property="Height" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RowDefinition.Style>
                        </RowDefinition>
                    </Grid.RowDefinitions>

                    <!-- 组稿区 -->
                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{StaticResource BorderTertiary}" BorderThickness="0,0,0,0.5">
                        <StackPanel>
                            <TextBlock Text="{Binding RecipeSummary}" Foreground="{StaticResource TextSecondary}"
                                       FontSize="12" />

                            <ItemsControl ItemsSource="{Binding Recipe}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource ChipBg}"
                                                BorderBrush="{StaticResource ChipBorder}" BorderThickness="0.5"
                                                CornerRadius="99" Padding="10,3" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11"
                                                           Foreground="{StaticResource ChipFg}"
                                                           VerticalAlignment="Center" />
                                                <Button Content="×" Style="{StaticResource GhostButton}"
                                                        Command="{Binding DataContext.RemoveChipCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="+ 存为预设" Command="{Binding SavePresetCommand}" />
                                <Button Content="按大纲自动推荐" Command="{Binding SuggestCorpusCommand}" />
                                <Button Content="终止" Command="{Binding CancelSuggestCommand}"
                                        Visibility="{Binding IsSuggesting, Converter={StaticResource BoolToVis}}" />
                                <Button Content="撤销推荐" Command="{Binding UndoSuggestCommand}"
                                        Visibility="{Binding CanUndoSuggest, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <TextBlock Text="{Binding SuggestResultText}" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding HasSuggestResult, Converter={StaticResource BoolToVis}}" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="标题" FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="1" FontSize="12"
                                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <TextBox Margin="0,6,0,0" Height="64" FontSize="12"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                             Text="{Binding Outline, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="{Binding TargetWordsHint}" FontSize="11"
                                               Foreground="{StaticResource TextTertiary}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                                    <Button Content="生成 ↗" Command="{Binding GenerateCommand}"
                                            Padding="18,6" />
                                    <Button Content="终止" Command="{Binding CancelGenerateCommand}"
                                            Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"
                                            Margin="0,6,6,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding RecipeWarning}" FontSize="11"
                                       Foreground="{StaticResource DangerBrush}"
                                       Visibility="{Binding HasRecipeWarning, Converter={StaticResource BoolToVis}}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 成品区：生成输出 -->
                    <Grid Grid.Row="1" Margin="14,10,14,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="生成输出" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DraftLabel}" FontSize="11"
                                           Foreground="{StaticResource TextTertiary}"
                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="420" />
                            </StackPanel>
                            <Button Content="{Binding EditPanelToggleText}" HorizontalAlignment="Right"
                                    Command="{Binding ToggleEditPanelCommand}" />
                        </Grid>

                        <TextBox x:Name="OutputBox" Grid.Row="1" FontSize="13" Padding="10"
                                 Text="{Binding OutputText, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled" />
                    </Grid>

                    <!-- 修改区上方的拖拽条：上下拉可以调整修改区高度 -->
                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  Background="{StaticResource BorderTertiary}"
                                  Visibility="{Binding IsEditPanelOpen, Converter={StaticResource BoolToVis}}" />

                    <!-- 修改区 -->
                    <Border Grid.Row="3" Padding="14,10"
                            Background="{StaticResource BgSecondary}"
                            BorderBrush="{StaticResource BorderTertiary}" BorderThickness="0,0.5,0,0"
                            Visibility="{Binding IsEditPanelOpen, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TabControl Grid.Row="0" IsEnabled="{Binding HasDraft}">

                                <!-- ========== 手动编辑 ========== -->
                                <TabItem Header="手动编辑">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBox Grid.Row="0" FontSize="13" MinHeight="80"
                                                 Text="{Binding EditingText, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled" />

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="保存为新版本" Command="{Binding SaveVersionCommand}" />
                                            <TextBlock Text="每存一次生成 v2、v3…，老版本文件永不覆盖。"
                                                       FontSize="11" Foreground="{StaticResource TextTertiary}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </TabItem>

                                <!-- ========== AI 修订 ========== -->
                                <TabItem Header="AI 修订">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" MinHeight="70" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 指令 -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" FontSize="12" Height="30"
                                                     Text="{Binding ReviseInstruction, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Grid.Column="1" Margin="10,0,0,0" FontSize="11"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding UseCorpusForRevision, Mode=TwoWay}"
                                                      Content="带上范文一起改（文风更稳）" />
                                        </Grid>

                                        <!-- 动作 -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="让模型改一版" Command="{Binding ReviseCommand}" />
                                            <Button Content="让模型自查一版" Command="{Binding SelfCheckCommand}" />
                                            <Button Content="终止"
                                                    Command="{Binding CancelReviseCommand}"
                                                    Visibility="{Binding IsRevising, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <!-- 对照：左＝编辑框里的稿，右＝修订稿（还没落盘） -->
                                        <Grid Grid.Row="2" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="原稿（编辑框里的内容）" FontSize="11"
                                                           Foreground="{StaticResource TextTertiary}"
                                                           Margin="0,0,0,4" />
                                                <TextBox Grid.Row="1" FontSize="12" IsReadOnly="True"
                                                         Background="{StaticResource BgTertiary}"
                                                         Text="{Binding EditingText, Mode=OneWay}"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         VerticalContentAlignment="Top"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Disabled" />
                                            </Grid>

                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="修订稿（满意才落盘）" FontSize="11"
                                                           Foreground="{StaticResource TextTertiary}"
                                                           Margin="0,0,0,4" />
                                                <TextBox Grid.Row="1" FontSize="12" IsReadOnly="True"
                                                         Text="{Binding RevisionText, Mode=OneWay}"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         VerticalContentAlignment="Top"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Disabled" />
                                            </Grid>
                                        </Grid>

                                        <!-- 字数对比 + 提醒 + 采纳 -->
                                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding RevisionSummary}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       TextWrapping="Wrap" />

                                            <TextBlock Text="{Binding RevisionWarning}" FontSize="11"
                                                       Foreground="{StaticResource DangerBrush}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HasRevisionWarning, Converter={StaticResource BoolToVis}}" />

                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="✓ 采纳这一版（落成新版本）"
                                                        Command="{Binding AdoptRevisionCommand}"
                                                        Background="{StaticResource OkBg}"
                                                        Foreground="{StaticResource OkFg}"
                                                        BorderBrush="{StaticResource OkBrush}" />
                                                <Button Content="丢弃修订稿"
                                                        Command="{Binding DiscardRevisionCommand}"
                                                        Foreground="{StaticResource DangerBrush}" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextTertiary}"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                                           Text="不点采纳就不落盘；采纳后原版本一个不动。" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </TabItem>

                                <!-- ========== 版本历史 ========== -->
                                <TabItem Header="版本历史">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300" MinWidth="200" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ListBox Grid.Column="0" ItemsSource="{Binding Versions}"
                                                 SelectedItem="{Binding SelectedVersion, Mode=TwoWay}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource BgPrimary}"
                                                            BorderBrush="{StaticResource BorderTertiary}"
                                                            BorderThickness="0.5"
                                                            CornerRadius="8" Padding="9,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="{Binding AccentWidth}"
                                                                    Background="{Binding AccentBrush}"
                                                                    CornerRadius="2" Margin="0,1,8,1" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding DisplayTitle}"
                                                                           FontWeight="SemiBold" FontSize="12" />
                                                                <TextBlock Text="{Binding MetaLine}" FontSize="11"
                                                                           Foreground="{StaticResource TextTertiary}"
                                                                           Margin="0,2,0,0" />
                                                                <TextBlock Text="{Binding DetailLine}" FontSize="11"
                                                                           Foreground="{StaticResource TextTertiary}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding RevertHintText}" FontSize="11"
                                                       Foreground="{StaticResource TextTertiary}"
                                                       TextWrapping="Wrap" Margin="0,0,0,6" />

                                            <TextBox Grid.Row="1" FontSize="12" IsReadOnly="True"
                                                     Background="{StaticResource BgTertiary}"
                                                     Text="{Binding VersionPreviewText, Mode=OneWay}"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Disabled" />

                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="↩ 回退到这个版本"
                                                        Command="{Binding RevertVersionCommand}" />
                                                <TextBlock Text="回退＝复制成新版本，历史一律不删。"
                                                           FontSize="11" Foreground="{StaticResource TextTertiary}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </TabItem>

                            </TabControl>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="✓ 确认，存入终稿" Command="{Binding ConfirmFinalCommand}"
                                        Background="{StaticResource OkBg}" Foreground="{StaticResource OkFg}"
                                        BorderBrush="{StaticResource OkBrush}" />
                                <Button Content="放弃本轮修改" Command="{Binding DiscardCommand}"
                                        Foreground="{StaticResource DangerBrush}" />
                                <TextBlock FontSize="11" Foreground="{StaticResource TextTertiary}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="底稿 v1 只读；编辑与 AI 修订都在副本上落新版本，final\ 软件不提供删除入口。" />
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </Border>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderTertiary}" BorderThickness="0.5"
                CornerRadius="0,0,12,12" Padding="16,6">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{StaticResource TextTertiary}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
