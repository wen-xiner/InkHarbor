<Window x:Class="InkHarbor.App.Views.CorpusEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InkHarbor" Width="760" Height="580" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgPrimary}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HintText" TextWrapping="Wrap" LineHeight="19"
                   Foreground="{StaticResource TextSecondary}" />

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="文件名" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" x:Name="NameBox" />
            <TextBlock Grid.Column="2" x:Name="ExtText" Text=".md" VerticalAlignment="Center"
                       Margin="8,0,0,0" Foreground="{StaticResource TextTertiary}" />
        </Grid>

        <TextBox Grid.Row="2" x:Name="BodyBox" Margin="0,12,0,0" FontSize="13"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled" />

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource TextTertiary}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Click="Cancel_Click" />
                <Button Content="保存" Click="Ok_Click" IsDefault="True" Margin="0"
                        Background="{StaticResource OkBg}" Foreground="{StaticResource OkFg}"
                        BorderBrush="{StaticResource OkBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
