<Window x:Class="InkHarbor.App.Views.CorpusPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="范文预览" Height="640" Width="640" MinHeight="380" MinWidth="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgPrimary}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="FileNameText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="MetaText" FontSize="11" Foreground="{StaticResource TextTertiary}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <TextBox x:Name="BodyBox" Grid.Row="1" Margin="0,10,0,0" FontSize="13"
                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled" />
    </Grid>
</Window>
